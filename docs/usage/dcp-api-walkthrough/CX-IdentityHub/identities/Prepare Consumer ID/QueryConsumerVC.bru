meta {
  name: QueryConsumerVC
  type: http
  seq: 6
}

get {
  url: {{CONSUMER_IDHUB_ID_API}}/v1alpha/participants/{{B64_CONS_ID}}/credentials
  body: json
  auth: none
}

headers {
  x-api-key: {{CONSUMER_IH_APIKEY}}
  ~x-api-key: ZGlkOndlYjpjb25zdW1lci1pZGh1Yi1ncnAtMDEuZGV2LmNvbnN0cnVjdC14Lm5ldDpjb25zdW1lcg==.64bddjt1ynndD7zEM1tzC1DcdQm1AJPLBpaH9zwy/yCVGI6bSdpKIWJiKEvSG/AVWPtpvY88Ka7F8aAOkqxSXQ==
}

script:pre-request {
  const btoa = require("btoa");
  const cons_id = bru.getEnvVar("CONS_ID");
  bru.setEnvVar("B64_CONS_ID", btoa(cons_id));
  
  req.setHeader("x-api-key", bru.getEnvVar("CONSUMER_IH_APIKEY"));
}

settings {
  encodeUrl: true
  timeout: 0
}
